@page
@using Projetositedeestudo.Views.Curso

<div class="container my-4">

    <h1 class="text-center mb-4 display-5 fw-bold text-primary">
        Detalhes do Conteudo
    </h1>

    <form method="post" asp-action="CursoDetalhes" asp-controller="Curso" class="p-4 rounded shadow-sm bg-light">

        <input type="hidden" name="Id" value="@ViewBag.Cursos.Id" />

        <!-- Nome do Curso -->
        <div class="mb-4">
            <label class="form-label fs-4 fw-semibold text-dark">
                Nome do Curso
            </label>
            <input class="form-control form-control-lg" 
                   name="Titulo" 
                   value="@ViewBag.Cursos.Titulo"
                   style="font-size: 1.5rem; padding: 12px;" />
        </div>

        <!-- Descrição -->
        <div class="mb-4">
            <label class="form-label fs-4 fw-semibold text-dark">
                Descrição
            </label>
            <textarea class="form-control form-control-lg" 
                      name="Descricao"
                      rows="3"
                      style="font-size: 1.5rem; padding: 12px;">@ViewBag.Cursos.Descricao</textarea>
        </div>

        <h2 class="mt-5 mb-3 fw-bold text-primary">Conteúdos do Curso</h2>

        <div class="row g-4">

            @foreach (Atividade atividade in ViewBag.ListaAtividades)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-lg rounded-4 p-3" 
                         style="background-color: #f7fbff;">

                        <div class="card-body">

                            <h3 class="fw-bold text-dark mb-3" 
                                style="font-size: 1.8rem;">
                                @atividade.Titulo
                            </h3>

                            <a href="/Atividade/Conteudo/@atividade.Id"
                               class="btn btn-primary w-100 py-3 fs-4 fw-bold rounded-3"
                               style="font-size: 1.5rem;">
                                Começar Atividade
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="mt-5">
            <a href="/Curso"
               class="btn btn-secondary w-100 py-3 fs-4 fw-bold rounded-3"
               style="font-size: 1.5rem;">
                Voltar
            </a>
        </div>

    </form>
</div>
