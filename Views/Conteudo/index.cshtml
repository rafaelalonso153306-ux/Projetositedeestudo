@{
    ViewBag.Title = "Catálogo Acessível de Cursos";
    Layout = null;
}
 
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
 
    <style>
        :root {
            --bg: #f7fbff;
            --card-bg: #ffffff;
            --primary: #0d6efd;
            --muted: #4b5563;
        }
 
        body {
            background: var(--bg);
            font-family: "Segoe UI", Roboto, Arial;
            font-size: 18px;
            color: #0b1220;
        }
 
        .container-main { max-width:1200px; margin:32px auto; padding: 0 16px; }
 
        /* Breadcrumbs */
        .breadcrumb {
            background: transparent;
            padding-left:0;
            margin-bottom: 18px;
        }
 
        /* Títulos */
        .page-title { font-size: 28px; font-weight: 700; }
        .page-desc { color: var(--muted); }
 
        /* Cards */
        .cards {
            display:grid;
            grid-template-columns: repeat(auto-fill,minmax(320px,1fr));
            gap: 16px;
        }
 
        .card-access {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 16px;
            display:flex;
            gap:12px;
            align-items:flex-start;
            border-left: 8px solid var(--primary);
            transition: transform .16s ease, box-shadow .16s ease;
        }
 
        .card-access:hover { transform: translateY(-6px); box-shadow: 0 12px 28px rgba(0,0,0,0.15); }
 
        .card-icon {
            width:64px; height:64px;
            display:flex; align-items:center; justify-content:center;
            background:#eef8ff;
            border-radius:10px;
            font-size:30px;
            color:var(--primary);
        }
 
        .card-title { font-size:18px; font-weight:700; }
        .card-sub { color:var(--muted); font-size:15px; margin-bottom:10px; }
 
        .btn-primary-cta {
            background: var(--primary);
            color: white;
            border:none;
            padding:10px 14px;
            border-radius:10px;
            font-weight:700;
        }
 
        /* Leitura Fácil */
        .leitura-facil { font-size: 22px !important; }
 
        /* Alto contraste */
        .alto-contraste { background:black !important; color:white !important; }
        .alto-contraste .card-access { background:#111 !important; border-left-color:white !important; }
    </style>
</head>
 
<body>
    <div class="container-main">
 
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Início</a></li>
                <li class="breadcrumb-item active">Catálogo Acessível</li>
            </ol>
        </nav>
 
        <!-- Título -->
        <header class="mb-3 d-flex justify-content-between">
            <div>
                <h1 class="page-title">Catálogo de Cursos — Modo Acessível</h1>
                <p class="page-desc">Navegue pelos conteúdos disponíveis. Layout com leitura por voz e acessibilidade.</p>
            </div>
 
            <div class="d-flex gap-2">
                <button id="toggleLeitura" class="btn btn-outline-primary">
                    <i class="bi bi-eyeglasses"></i> Leitura fácil
                </button>
 
                <button id="toggleContraste" class="btn btn-outline-dark">
                    <i class="bi bi-circle-half"></i> Alto contraste
                </button>
 
                <button id="lerTudo" class="btn btn-outline-success">
                    <i class="bi bi-volume-up"></i> Ouvir página
                </button>
            </div>
        </header>
 
        <main>
            <section>
                <h2 class="mb-3">Lista de Conteúdos</h2>
 
                <div class="cards">
                    @foreach (var item in ViewBag.ListaConteudos)
                    {
                        <article class="card-access" tabindex="0">
                            <div class="card-icon">
                                <i class="bi bi-journal-bookmark"></i>
                            </div>
 
                            <div>
                                <div class="card-title">@item.Nome</div>
                                <div class="card-sub">@item.Curso</div>
 
                                <div class="d-flex gap-2">
                                    <button class="btn btn-light btn-sm"
                                            onclick="speak('@item.Nome. Curso: @item.Curso')">
                                        <i class="bi bi-volume-up"></i> Ouvir
                                    </button>
 
                                    <a href="@Url.Action("Detalhes","Conteudo", new { id = item.Id })"
                                       class="btn-primary-cta btn-sm">
                                        Abrir
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        </main>
    </div>
 
    <script>
        function speak(text) {
            const u = new SpeechSynthesisUtterance(text);
            u.lang = "pt-BR";
            u.rate = 0.95;
            speechSynthesis.speak(u);
        }
 
        document.getElementById("toggleLeitura").onclick = () =>
            document.body.classList.toggle("leitura-facil");
 
        document.getElementById("toggleContraste").onclick = () =>
            document.body.classList.toggle("alto-contraste");
 
        document.getElementById("lerTudo").onclick = () =>
            speak("Lista de conteúdos disponível na página.");
    </script>
</body>
</html>
