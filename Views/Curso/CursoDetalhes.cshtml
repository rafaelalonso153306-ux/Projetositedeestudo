@page

<h1>Detalhes do Curso</h1>

<form method="post" asp-action="CursoDetalhes" asp-controller="Curso">

    <input type="hidden" name="Id" value="@ViewBag.Cursos.Id" />

    <div class="mb-3">
        <label class="form-label">Nome do Curso</label>
        <input class="form-control" name="Titulo" value="@ViewBag.Cursos.Titulo" />
    </div>

    <div class="mb-3">
        <label class="form-label">Descrição</label>
        <textarea class="form-control" name="Descricao">@ViewBag.Cursos.Descricao</textarea>
    </div>

    @* <button type="submit" class="btn btn-success">Salvar</button> *@

    <!-- BIOLOGIA – INTERMEDIÁRIO -->
    @foreach(Conteudo conteudo in ViewBag.ListaConteudos)
    {
        <div class="col-6">
            <div class="card shadow-sm p-3 card-horizontal">
                @* <img src="https://via.placeholder.com/300x200?text=Biology+Cells" class="course-img"> *@

                <div class="flex-fill">
                    @* <h5>Biologia – Intermediário – Genética, reinos biológicos e ecossistemas.</h5> *@
                    <h3>@conteudo.Nome</h3>
                     
                </div>
            </div>
        </div>
    }

    <a href="/Curso" class="btn btn-secondary ms-2">Voltar</a>
</form>
