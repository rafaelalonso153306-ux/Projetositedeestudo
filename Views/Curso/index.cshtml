<!-- Cabeçalho -->
<header class="bg-light text-center py-4">
  <h1 class="mb-2">Escolha o Ano</h1>
  <p>Selecione o ano escolar para ver as matérias e atividades.</p>
</header>

<!-- Botões dos anos -->
<section class="container text-center mb-4">
  <div class="d-flex flex-wrap justify-content-center gap-3">
    <button class="btn btn-outline-primary btn-lg">1º Ano</button>
    <button class="btn btn-outline-primary btn-lg">2º Ano</button>
    <button class="btn btn-outline-primary btn-lg">3º Ano</button>
    <button class="btn btn-outline-primary btn-lg">4º Ano</button>
    <button class="btn btn-outline-primary btn-lg">5º Ano</button>
    <button class="btn btn-outline-primary btn-lg">6º Ano</button>
    <button class="btn btn-outline-primary btn-lg">7º Ano</button>
    <button class="btn btn-outline-primary btn-lg">8º Ano</button>
    <button class="btn btn-outline-primary btn-lg">9º Ano</button>
  </div>
</section>

<!-- LISTA DE CURSOS -->
<div class="row g-3">

    <!-- BIOLOGIA – INTERMEDIÁRIO -->
    @foreach(Curso curso in ViewBag.ListaCursos)
    {
        <div class="col-6">
            <div class="card shadow-sm p-3 card-horizontal">
                <img src="https://via.placeholder.com/300x200?text=Biology+Cells" class="course-img">

                <div class="flex-fill">
                    @* <h5>Biologia – Intermediário – Genética, reinos biológicos e ecossistemas.</h5> *@
                    <h3>@curso.Titulo</h3>
                    <h5>@curso.NivelDificuldade</h5>
                    <p class="text-muted small">Fonte: google</p>
                    @* <span class="badge bg-success mb-2">Publicado</span> *@

                    <p>@curso.Descricao</p>

                    <a href="/CursoDetalhes/@curso.Id" class="btn btn-primary btn-sm">
                        Ver detalhes
                    </a>
                </div>
            </div>
        </div>
    }
