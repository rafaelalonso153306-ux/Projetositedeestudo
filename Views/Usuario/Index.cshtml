@page

<div class="container py-4">

    <!-- TÍTULO DA PÁGINA -->
    <div class="text-center mb-4">
        <h1 class="fw-bold display-5 text-primary">Crie Sua Conta</h1>
        <p class="lead">Preencha os campos abaixo para começar a aprender!</p>
    </div>

    <!-- CARD DO CADASTRO -->
    <div class="card shadow-lg p-4 rounded-4 mb-5" style="font-size: 1.3rem;">
        <h3 class="text-center mb-4 fw-semibold">Informações do Usuário</h3>

        <form method="POST" asp-action="Cadastrar" asp-controller="Usuario" class="needs-validation" novalidate>

            <!-- NOME -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Nome do Usuário</label>
                <input type="text" name="Nome" class="form-control form-control-lg rounded-3" placeholder="Digite seu nome" required>
            </div>

            <!-- EMAIL -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Email</label>
                <input type="email" name="Email" class="form-control form-control-lg rounded-3" placeholder="seuemail@exemplo.com" required>
            </div>

            <!-- SENHA -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Senha</label>
                <input type="password" name="Senha" class="form-control form-control-lg rounded-3" placeholder="Digite sua senha" required>
            </div>

            <!-- CURSO -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Escolha um Curso</label>
                <select class="form-select form-select-lg rounded-3" name="IdEquipe" required>
                    <option selected disabled>Selecione um curso</option>

                    @if (ViewBag.ListaCursos != null && ViewBag.ListaCursos.Count > 0)
                    {
                        @foreach (Curso curso in ViewBag.ListaCursos)
                        {
                            <option value="@curso.Id">@curso.Titulo</option>
                        }
                    }
                </select>
            </div>

            <!-- BOTÃO -->
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary btn-lg px-5 py-2 rounded-pill fw-bold" style="font-size: 1.4rem;">
                    Cadastrar
                </button>
            </div>
        </form>
    </div>

    <!-- LISTA DE USUÁRIOS -->
    <h2 class="fw-bold text-center mb-3 text-secondary" style="font-size: 2rem;">Usuários Cadastrados</h2>

    <div class="table-responsive">
        <table class="table table-striped table-bordered text-center align-middle" style="font-size: 1.2rem;">
            <thead class="table-primary">
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Senha</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @if (ViewBag.listaUsuarios != null && ViewBag.listaUsuarios.Count > 0)
                {
                    @foreach (Usuario usuario in ViewBag.listaUsuarios)
                    {
                        <tr>
                            <td>@usuario.Nome</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.Senha</td>

                            <td>
                                <a class="btn btn-success btn-sm fw-bold rounded-pill px-3" href="/Usuario/Atualizar/@usuario.Id">
                                    Editar
                                </a>

                                <a class="btn btn-danger btn-sm fw-bold rounded-pill px-3"
                                   asp-action="ExcluirUsuario"
                                   asp-controller="Usuario"
                                   asp-route-id="@usuario.Id">
                                    Excluir
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
