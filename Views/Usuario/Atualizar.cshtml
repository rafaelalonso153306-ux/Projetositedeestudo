@page
<div class="container mt-4">

    <!-- Título acessível e amigável -->
    <h1 class="text-center mb-4 fw-bold" style="font-size: 2rem;">
        ✏️ Atualizar Usuário
    </h1>

    <div class="card shadow p-4" style="border-radius: 20px;">
        <form method="post" asp-action="AtualizarUsuario" asp-controller="Usuario">

            <!-- ID escondido -->
            <input type="hidden" name="Id" value="@ViewBag.Usuarios.Id" />

            <!-- Nome -->
            <div class="mb-3">
                <label class="form-label fs-5 fw-semibold">👤 Nome do Usuário</label>
                <input type="text"
                       name="Nome"
                       class="form-control form-control-lg"
                       style="border-radius: 12px;"
                       value="@ViewBag.Usuarios.Nome"
                       required />
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label class="form-label fs-5 fw-semibold">📧 Email</label>
                <input type="email"
                       name="Email"
                       class="form-control form-control-lg"
                       style="border-radius: 12px;"
                       value="@ViewBag.Usuarios.Email"
                       required />
            </div>

            <!-- Botões grandes e claros -->
            <div class="d-flex gap-3 mt-4">
                <button class="btn btn-primary btn-lg w-50"
                        style="border-radius: 12px;">
                    💾 Salvar Alterações
                </button>

                <a href="/Usuario" 
                   class="btn btn-secondary btn-lg w-50"
                   style="border-radius: 12px;">
                    ↩️ Voltar
                </a>
            </div>
        </form>
    </div>
</div>
