@page

<!-- Lista de matérias -->
<main class="container" id="materias">
  <h2 class="text-center mb-4">Matérias do <span id="anoSelecionado"></span>º Ano</h2>
  <div class="row g-3">
    <!-- Cards -->
    <div class="col-md-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-pencil-square"></i>Língua Portuguesa</h5>
          <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#modalLinguaPortuguesa">Ver
            Atividades</button>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-calculator"></i> Matemática</h5>
          <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#modalMatematica">Ver
            Atividades</button>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-flask"></i> Ciências</h5>
          <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#modalCiencias">Ver
            Atividades</button>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-clock-history"></i> História</h5>
          <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#modalHistoria">Ver
            Atividades</button>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-map"></i> Geografia</h5>
          <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#modalGeografia">Ver
            Atividades</button>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-palette"></i> Arte</h5>
          <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#modalArte">Ver
            Atividades</button>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-pencil-square"></i>Biologia</h5>
          <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#modalBiologia">Ver
            Atividades</button>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-pencil-square"></i>Língua Inglesa</h5>
          <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#modalLinguaInglesa">Ver
            Atividades</button>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Modais com 5 atividades por matéria -->
<!-- Português -->
<div class="modal fade" id="modalLinguaPortuguesa" tabindex="-1" aria-labelledby="modalLinguaPortuguesaLabel"
  aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="modalLinguaPortuguesa" class="modal-title">Língua Portuguesa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="atividade-list">
          <li>1. Leia e identifique a letra inicial das palavras.</li>
          <li>2. Complete as palavras com a letra que falta.</li>
          <li>3. Separe as sílabas corretamente.</li>
          <li>4. Encontre palavras que rimam.</li>
          <li>5. Responda à pergunta sobre um texto simples.</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Matemática -->
<div class="modal fade" id="modalMatematica" tabindex="-1" aria-labelledby="modalMatematicaLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="modalMatematicaLabel" class="modal-title">Matemática</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="atividade-list">
          <li>1. Resolva a soma: 2 + 3 = ?</li>
          <li>2. Resolva a subtração: 5 - 1 = ?</li>
          <li>3. Complete a sequência: 1, 2, 3, ___</li>
          <li>4. Conte os objetos: ★★★★</li>
          <li>5. Compare: Qual número é maior?</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Ciências -->
<div class="modal fade" id="modalCiencias" tabindex="-1" aria-labelledby="modalCienciasLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="modalCienciasLabel" class="modal-title">Ciências</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="atividade-list">
          <li>1. Aponte as partes do corpo.</li>
          <li>2. Cite um animal doméstico.</li>
          <li>3. O que uma planta precisa para viver?</li>
          <li>4. Qual é a estação mais fria?</li>
          <li>5. Dê um exemplo de hábito saudável.</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- História -->
<div class="modal fade" id="modalHistoria" tabindex="-1" aria-labelledby="modalHistoriaLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="modalHistoriaLabel" class="modal-title">História</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="atividade-list">
          <li>1. Quem descobriu o Brasil?</li>
          <li>2. Cite um fato histórico importante.</li>
          <li>3. Qual era a capital do Brasil em 1808?</li>
          <li>4. Quem foi D. Pedro I?</li>
          <li>5. Qual é a data da Independência do Brasil?</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Geografia -->
