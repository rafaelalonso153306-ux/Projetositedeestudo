<style>
  body {
    font-size: 18px;
  }

  .btn-lg {
    font-size: 1.2rem;
  }

  .card-title {
    font-weight: bold;
  }

  .atividade-list li {
    margin-bottom: 8px;
  }
</style>

<script>
  function mostrarMaterias(ano) {
    document.getElementById('materias').style.display = 'block';
    document.getElementById('anoSelecionado').textContent = ano;
    window.scrollTo({ top: document.getElementById('materias').offsetTop, behavior: 'smooth' });
  }
</script>