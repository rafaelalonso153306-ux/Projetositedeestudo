@page

<div class="container my-4">

    <h1 class="text-center mb-4 display-5 fw-bold text-primary">
        Detalhes do Conteudo
    </h1>


        <h2 class="mt-5 mb-3 fw-bold text-primary">Conteúdos do Curso</h2>

        <div class="row g-4">

            @foreach (Atividade atividade in ViewBag.ListaAtividades)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-lg rounded-4 p-3" 
                         style="background-color: #f7fbff;">

                        <div class="card-body">

                            <h3 class="fw-bold text-dark mb-3" 
                                style="font-size: 1.8rem;">
                                @atividade.Titulo
                            </h3>

                            <a href="/Atividade/Conteudo/@atividade.Id"
                               class="btn btn-primary w-100 py-3 fs-4 fw-bold rounded-3"
                               style="font-size: 1.5rem;">
                                Começar Atividade
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="mt-5">
            <a href="/Curso"
               class="btn btn-secondary w-100 py-3 fs-4 fw-bold rounded-3"
               style="font-size: 1.5rem;">
                Voltar
            </a>
        </div>
</div>
